{% comment %}
  Row of icon + short reassurance messages (shipping, returns, secure checkout...).
{% endcomment %}
{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}

<div class="trust-badges color-{{ section.settings.color_scheme }} gradient">
  <ul
    class="trust-badges__list page-width list-unstyled"
    style="--trust-padding-top: {{ section.settings.padding_top }}px; --trust-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {%- for block in section.blocks -%}
      <li class="trust-badges__item" {{ block.shopify_attributes }}>
        <span class="trust-badges__icon">{% render 'icon-accordion', icon: block.settings.icon %}</span>
        <div>
          <p class="trust-badges__title h5">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}
            <p class="trust-badges__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "perfume", "label": "Perfume" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "box", "label": "Box" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "plane", "label": "Plane" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders over $50" } },
        { "type": "badge", "settings": { "icon": "return", "title": "30-day returns", "text": "Not in love? Send it back" } },
        { "type": "badge", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted payments" } },
        { "type": "badge", "settings": { "icon": "chat_bubble", "title": "Real support", "text": "Replies within 24 hours" } }
      ]
    }
  ]
}
{% endschema %}
