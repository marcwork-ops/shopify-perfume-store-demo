{% comment %}
  Hero banner with text over the empty side of a wide image.
  Uses the uploaded image when set, otherwise falls back to the bundled perfume-hero-*.jpg assets.
{% endcomment %}
{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fallback_widths = '750,1500,2400,3840' | split: ','
  assign alt = section.settings.image.alt | default: section.settings.heading | escape
-%}

<div
  class="hero-banner hero-banner--{{ section.settings.text_position }} color-{{ section.settings.color_scheme }} gradient"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-focal-mobile: {{ section.settings.mobile_focal_point }}% 50%;"
>
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'hero-banner__image',
          widths: '750, 1100, 1500, 2200, 3000, 3840',
          sizes: '100vw',
          fetchpriority: 'high',
          loading: 'eager',
          alt: alt
      }}
    {%- else -%}
      <img
        class="hero-banner__image"
        src="{{ 'perfume-hero-2400.jpg' | asset_url }}"
        srcset="
          {%- for w in fallback_widths -%}
            {%- assign file = 'perfume-hero-' | append: w | append: '.jpg' -%}
            {{ file | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}
          {%- endfor -%}
        "
        sizes="100vw"
        width="3840"
        height="1800"
        alt="{{ alt }}"
        fetchpriority="high"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="hero-banner__content page-width">
    <div class="hero-banner__box">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="hero-banner__eyebrow caption-with-letter-spacing" {{ block.shopify_attributes }}>
              {{- block.settings.text | escape -}}
            </p>
          {%- when 'heading' -%}
            <h2 class="hero-banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </h2>
          {%- when 'text' -%}
            <div class="hero-banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'buttons' -%}
            <div class="hero-banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}"
                  class="button button--primary"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_link_2 | default: routes.all_products_collection_url }}"
                  class="button button--secondary"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Wide image (about 2:1) with empty space on one side. Leave blank to use the bundled perfume image."
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_focal_point",
      "label": "Mobile image focus (horizontal)",
      "info": "Moves the crop on mobile so the products stay visible.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow text",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New collection" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Scents that stay with you" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h0"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Small-batch fragrances, made to last from morning to night.</p>" }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label_1", "label": "First button label", "default": "Shop best sellers" },
        { "type": "url", "id": "button_link_1", "label": "First button link" },
        { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "Find your scent" },
        { "type": "url", "id": "button_link_2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "buttons" }]
    }
  ]
}
{% endschema %}
